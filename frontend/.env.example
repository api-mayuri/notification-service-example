# Frontend settings for `npm run dev` / `npm run build`: copy to .env and edit.
# In Docker the same settings come without the VITE_ prefix (see docker-compose.yml and the root .env.example).

# Backend for the Vite dev proxy (/api, /dev, /actuator, /v3/api-docs, /swagger-ui)
DEV_BACKEND_URL=http://localhost:8080
DEV_PORT=5173

VITE_APP_TITLE=Notification Service
# Empty: same origin (through the proxy). Otherwise the backend must allow CORS.
VITE_API_URL=
# dev-token: login via POST /dev/token (backend profile local); bearer: paste a token from your IdP
VITE_AUTH_MODE=dev-token
VITE_DEV_TOKEN_CLIENT_ID=admin-ui
VITE_DEFAULT_LOCALE=ru
# Refresh of notification details while in progress, ms; 0 disables
VITE_POLL_INTERVAL_MS=5000
VITE_SWAGGER_URL=/swagger-ui.html
VITE_MAILPIT_URL=http://localhost:8025
VITE_KAFKA_UI_URL=http://localhost:8088
# Channels added on the backend besides the built-in ones, comma-separated
VITE_EXTRA_CHANNELS=
# Provider per channel as configured on the backend (notification.channels.<channel>.provider)
VITE_CHANNEL_PROVIDERS=EMAIL=smtp,SMS=logging,TELEGRAM=logging,WHATSAPP=logging,PUSH=logging,WEBHOOK=http
