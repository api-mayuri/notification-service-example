# docker compose settings: copy to .env (next to docker-compose.yml) and edit. Everything is optional.

# --- Admin UI (frontend service) ---
FRONTEND_PORT=3000
FRONTEND_TITLE=Notification Service
# dev-token: login via POST /dev/token (profile local); bearer: paste a token from your IdP
FRONTEND_AUTH_MODE=dev-token
FRONTEND_DEV_CLIENT_ID=admin-ui
FRONTEND_LOCALE=ru
FRONTEND_POLL_INTERVAL_MS=5000
FRONTEND_SWAGGER_URL=/swagger-ui.html
FRONTEND_MAILPIT_URL=http://localhost:8025
FRONTEND_KAFKA_UI_URL=http://localhost:8088
# Channels added on the backend besides the built-in ones, comma-separated (e.g. VIBER)
FRONTEND_EXTRA_CHANNELS=

# --- Channel providers: read by the service and shown in the admin UI ---
EMAIL_PROVIDER=smtp
SMS_PROVIDER=logging
TELEGRAM_PROVIDER=logging
WHATSAPP_PROVIDER=logging
PUSH_PROVIDER=logging
WEBHOOK_PROVIDER=http

# --- Email (defaults: Mailpit from this compose file) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=no-reply@notifications.local
MAIL_FROM_NAME=Notifications

# --- Webhook channel ---
WEBHOOK_SIGNING_SECRET=local-webhook-secret
